# cpstands runtime configuration.
# Copy to `.env` and fill in the values. NEVER commit `.env` (it is git-ignored).

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather. Keep it secret; rotate with /revoke if it ever leaks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=cpstandsbot
# Numeric Telegram user id of the bot owner (receives admin alerts).
TELEGRAM_OWNER_ID=
# Long polling for development, webhook for production.
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
# Random string checked against the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# --- Application --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Optional secret salt for hashing Telegram ids in logs (random per process if empty).
LOG_HASH_SALT=
DEFAULT_LANGUAGE=uz
SUPPORTED_LANGUAGES=uz,ru,en
# Replace emoji in messages with Telegram custom emoji (needs Premium on the bot owner).
CUSTOM_EMOJI=true
# Show custom emoji as button icons (needs additional Fragment usernames on the bot).
BUTTON_ICONS=false
DEFAULT_TIMEZONE=Asia/Tashkent
DATABASE_URL=sqlite+aiosqlite:///./data/cpstands.db

# --- Codeforces ---------------------------------------------------------------
CF_API_BASE=https://codeforces.com/api
# The public API allows about 1 request per 2 seconds.
CF_MIN_REQUEST_INTERVAL_SECONDS=2

# --- kep.uz -------------------------------------------------------------------
KEP_API_BASE=https://kep.uz/api
# Keep disabled until the integration is built and the owner has confirmed terms.
KEP_ENABLED=false

